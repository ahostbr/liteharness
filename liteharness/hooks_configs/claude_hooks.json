{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m liteharness.hooks register",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m liteharness.hooks check",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m liteharness.hooks check",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m liteharness.hooks deregister",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m liteharness.tts.smart_tts \"Work complete\" --type stop --source global",
            "timeout": 90000
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m liteharness.hooks stop-failure",
            "timeout": 5000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m liteharness.tts.smart_tts \"Task finished\" --type subagent --source global",
            "timeout": 90000
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m liteharness.tts.smart_tts \"Your attention is needed\" --type notification --source global",
            "timeout": 90000
          }
        ]
      }
    ]
  }
}
